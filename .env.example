# Runtime-only settings for Compose. Tailscale credentials, notification
# destinations, and the optional webhook secret are entered in the web UI.
# Every variable is described in README.md ("Runtime configuration").
# TAILSTATE_LISTEN_ADDR, TAILSTATE_DATA_DIR, and TAILSTATE_CONTAINER are fixed
# by compose.yaml (0.0.0.0:8080, /data, 1) and are not read from this file.

# --- Compose-file variables (container, image, publishing, secret mount) ---
TAILSTATE_CONTAINER_NAME=tailstate
# Pin a released version (see CHANGELOG.md) or a verified digest instead of
# following latest, and change it deliberately when upgrading (UPGRADING.md):
#   TAILSTATE_IMAGE=ghcr.io/crypt0rr/tailstate@sha256:<verified-digest>
TAILSTATE_IMAGE=ghcr.io/crypt0rr/tailstate:0.19.0
# Host address and port of the published UI. Keep loopback unless a firewall
# and a TLS-terminating proxy already restrict access to the host port.
TAILSTATE_BIND_ADDRESS=127.0.0.1
TAILSTATE_PORT=8080
TAILSTATE_MASTER_KEY_FILE=./secrets/tailstate_master_key
# Compose memory ceiling; raise only after sizing for your tailnet.
TAILSTATE_MEMORY_LIMIT=512m

# --- Application settings ---
# Set to true only behind a TLS-terminating proxy listed in
# TAILSTATE_TRUSTED_PROXIES; startup rejects it without a trusted proxy.
TAILSTATE_COOKIE_SECURE=false
# Bearer token for /metrics (generate with: openssl rand -hex 32). Required to
# scrape /metrics from outside the container; when empty, /metrics returns 401
# to everything outside the container, including requests to the published port.
TAILSTATE_METRICS_TOKEN=
# Optional comma-separated proxy IPs/CIDRs; only these may supply
# X-Forwarded-For and X-Forwarded-Proto.
TAILSTATE_TRUSTED_PROXIES=
# info or debug.
TAILSTATE_LOG_LEVEL=info
# Optional external https URL of this instance; notifications then link to
# the matching History batch and to the Status page.
TAILSTATE_PUBLIC_URL=
# Optional name (at most 64 printable bytes) shown in every notification title
# next to the tailnet.
TAILSTATE_INSTANCE_LABEL=

# --- Optional storage limits in bytes (unset or 0 uses the default shown) ---
# See docs/operations.md ("Storage limits") before changing them.
# TAILSTATE_SNAPSHOT_LIMIT_BYTES=1048576
# TAILSTATE_EVENT_VALUE_LIMIT_BYTES=524288
# TAILSTATE_HISTORY_PAGE_LIMIT_BYTES=2097152
# TAILSTATE_REJECT_LIMIT_BYTES=4194304
# TAILSTATE_DATABASE_LIMIT_BYTES=536870912
