{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|\\/)scripts\\/backup-image\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>[^\\s]+)\\nbackup_image=\"\\$\\{TAILSTATE_BACKUP_IMAGE:-[^\":]+:(?<currentValue>[^@\"]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\\}\""
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Digest-pinned images used through docker run in workflow steps",
      "managerFilePatterns": [
        "/(^|\\/)\\.github\\/workflows\\/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>prom\\/prometheus):(?<currentValue>v[0-9][^@\\s]*)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The go.mod go directive and the Dockerfile GO_VERSION argument follow the golang builder image tag, so a Go release updates all three together (scripts/check-go-toolchain.sh rejects a partial update)",
      "managerFilePatterns": [
        "/(^|\\/)go\\.mod$/",
        "/(^|\\/)Dockerfile$/"
      ],
      "matchStrings": [
        "\\ngo (?<currentValue>\\d+\\.\\d+\\.\\d+)\\n",
        "\\nARG GO_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\n"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Group digest-only refreshes of pinned images and actions into one weekly PR and merge it automatically once required CI checks pass.",
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "groupName": "pinned digests",
      "schedule": [
        "before 6am on monday"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Give new Go module releases time to be retracted before they are proposed.",
      "matchManagers": [
        "gomod"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "The regex manager above owns the go directive, so the gomod manager does not propose it separately.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "enabled": false
    },
    {
      "description": "One PR per Go release: the builder image, the go directive, and GO_VERSION must change together.",
      "matchDepNames": [
        "golang"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "groupName": "Go toolchain"
    }
  ]
}
